"""Settings for {{ project.name }}, read from environment variables and .env.

Every value here has a matching line in .env.example.
"""

from __future__ import annotations

from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file=(".env", "../.env"), extra="ignore")

    app_name: str = {{ project.name | pystr }}

    # Model provider. "fake" runs an offline demo model so you can click through the
    # whole app (and run the tests) without an API key.
    llm_provider: str = {{ llm.provider | pystr }}
    llm_model: str = {{ llm.model | pystr }}
    llm_temperature: float = {{ llm.temperature }}
    llm_effort: str | None = {{ llm.effort | py }}
    llm_max_tokens: int = {{ llm.max_tokens }}
    # Server-side refusal fallback for Claude models that support it: "default" or "off".
    anthropic_refusal_fallback: str = "default"
    anthropic_api_key: str | None = None
    openai_api_key: str | None = None

    # Conversation state: memory | sqlite | postgres
    checkpointer: str = {{ short_term | pystr }}
    database_url: str = "postgresql://app:app@localhost:5432/app"
    sqlite_path: str = "data/checkpoints.sqlite"

    cors_origins: list[str] = ["http://localhost:{{ deploy.frontend_port }}"]
    data_dir: str = "data"
    recursion_limit: int = {{ recursion_limit }}
{% if web_search_tools %}

    tavily_api_key: str | None = None
{% endif %}
{% if mcp_servers %}

    # Skip connecting to MCP servers (tests, or when a server is offline).
    skip_mcp: bool = False
{% endif %}
{% if has_rag %}

    # Knowledge bases. The overrides swap in in-process stand-ins for tests.
    vector_store_override: str | None = None
    embeddings_override: str | None = None
    reranker_override: str | None = None
    chroma_path: str = "data/chroma"
    cohere_api_key: str | None = None
{% endif %}


@lru_cache
def get_settings() -> Settings:
    return Settings()
