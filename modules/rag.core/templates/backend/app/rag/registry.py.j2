"""The knowledge bases in this app, as configured on the canvas."""

from __future__ import annotations

from dataclasses import dataclass

from app.rag.retriever import KnowledgeBase


@dataclass(frozen=True)
class KnowledgeConfig:
    id: str
    label: str
    description: str
    sources: tuple[str, ...]
    chunker: str
    chunk_size: int
    overlap: int
    embedding: str
    vector_store: str
    retrieval: str
    top_k: int
    reranker: str


KNOWLEDGE_BASES: dict[str, KnowledgeConfig] = {
{% for k in knowledge %}
    {{ k.id | pystr }}: KnowledgeConfig(
        id={{ k.id | pystr }},
        label={{ k.label | pystr }},
        description={{ k.data.description | pystr }},
        sources={{ k.data.sources | pytuple }},
        chunker={{ k.data.chunker | pystr }},
        chunk_size={{ k.data.chunk_size }},
        overlap={{ k.data.overlap }},
        embedding={{ k.data.embedding | pystr }},
        vector_store={{ k.data.vector_store | pystr }},
        retrieval={{ k.data.retrieval | pystr }},
        top_k={{ k.data.top_k }},
        reranker={{ k.data.reranker | pystr }},
    ),
{% endfor %}
}

_instances: dict[str, KnowledgeBase] = {}


def get_knowledge_base(kb_id: str) -> KnowledgeBase:
    if kb_id not in _instances:
        _instances[kb_id] = KnowledgeBase(KNOWLEDGE_BASES[kb_id])
    return _instances[kb_id]
