"""Vector store interface, plus an in-memory store used by tests and demo mode."""

from __future__ import annotations

import math
import re
from dataclasses import dataclass, field
from typing import Any, Protocol


@dataclass
class Chunk:
    id: str
    content: str
    source: str
    metadata: dict[str, Any] = field(default_factory=dict)


@dataclass
class Hit:
    id: str
    content: str
    source: str
    score: float


class VectorStore(Protocol):
    async def add(self, chunks: list[Chunk], vectors: list[list[float]]) -> None: ...

    async def delete_source(self, source: str) -> None: ...

    async def dense(self, vector: list[float], k: int) -> list[Hit]: ...

    async def keyword(self, query: str, k: int) -> list[Hit]: ...

    async def count(self) -> int: ...


def tokenize(text: str) -> list[str]:
    return re.findall(r"\w+", text.lower())


def bm25_rank(query: str, docs: list[tuple[str, str, str]], k: int) -> list[Hit]:
    """Keyword ranking over (id, content, source) triples."""
    if not docs:
        return []
{% if hybrid %}
    from rank_bm25 import BM25Okapi

    bm25 = BM25Okapi([tokenize(d[1]) or [""] for d in docs])
    scores = bm25.get_scores(tokenize(query))
{% else %}
    terms = set(tokenize(query))
    scores = [len(terms & set(tokenize(d[1]))) for d in docs]
{% endif %}
    ranked = sorted(zip(docs, scores, strict=True), key=lambda x: -x[1])[:k]
    return [Hit(id=d[0], content=d[1], source=d[2], score=float(s)) for d, s in ranked if s > 0]


class MemoryStore:
    """Everything in a Python list. Lost on restart; fine for tests and tiny demos."""

    def __init__(self) -> None:
        self.rows: list[tuple[Chunk, list[float]]] = []

    async def add(self, chunks: list[Chunk], vectors: list[list[float]]) -> None:
        self.rows.extend(zip(chunks, vectors, strict=True))

    async def delete_source(self, source: str) -> None:
        self.rows = [r for r in self.rows if r[0].source != source]

    async def dense(self, vector: list[float], k: int) -> list[Hit]:
        def cos(a: list[float], b: list[float]) -> float:
            dot = sum(x * y for x, y in zip(a, b, strict=False))
            na = math.sqrt(sum(x * x for x in a)) or 1.0
            nb = math.sqrt(sum(y * y for y in b)) or 1.0
            return dot / (na * nb)

        scored = sorted(((cos(vector, v), c) for c, v in self.rows), key=lambda x: -x[0])[:k]
        return [Hit(id=c.id, content=c.content, source=c.source, score=s) for s, c in scored]

    async def keyword(self, query: str, k: int) -> list[Hit]:
        return bm25_rank(query, [(c.id, c.content, c.source) for c, _ in self.rows], k)

    async def count(self) -> int:
        return len(self.rows)
