# Copy to .env and fill in the secrets. Never commit .env.

# --- Core backend (FastAPI + LangGraph)
# anthropic | openai | fake (fake = offline demo mode, no API calls)
LLM_PROVIDER=anthropic
# Default model for every step that doesn't name its own.
LLM_MODEL=claude-opus-5-5
# Browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000"]

# --- Anthropic (Claude)
# Your Claude API key, from https://platform.claude.com
ANTHROPIC_API_KEY=
# default = if a Claude safety classifier declines, retry on a fallback model in the same call; off = disable
ANTHROPIC_REFUSAL_FALLBACK=default

# --- Web search (Tavily)
# Web search. Free key at https://tavily.com
TAVILY_API_KEY=

# --- In-memory conversation state
# Conversation state store: memory | sqlite | postgres
CHECKPOINTER=memory
