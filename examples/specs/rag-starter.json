{
  "spec_version": "0.2",
  "project": {
    "name": "rag-starter",
    "description": "The classic RAG pipeline: always retrieve, then answer. Runs with one API key."
  },
  "llm": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "temperature": 0.2,
    "effort": null,
    "max_tokens": 4096
  },
  "backend": {
    "language": "python"
  },
  "graph": {
    "nodes": [
      {
        "id": "start",
        "position": {
          "x": 0.0,
          "y": 0.0
        },
        "type": "input",
        "data": {
          "label": "Chat input",
          "notes": "",
          "greeting": "Hi! What can I help you with?"
        }
      },
      {
        "id": "retrieve",
        "position": {
          "x": 250.0,
          "y": 0.0
        },
        "type": "retriever",
        "data": {
          "label": "Find passages",
          "notes": "",
          "top_k": null
        }
      },
      {
        "id": "answer",
        "position": {
          "x": 500.0,
          "y": 0.0
        },
        "type": "prompt",
        "data": {
          "label": "Answer from passages",
          "notes": "",
          "instructions": "Answer the user's question using only the retrieved passages. Cite passages as [1], [2]. If they don't answer the question, say you don't know.",
          "model": null,
          "temperature": null
        }
      },
      {
        "id": "reply",
        "position": {
          "x": 750.0,
          "y": 0.0
        },
        "type": "output",
        "data": {
          "label": "Reply",
          "notes": ""
        }
      },
      {
        "id": "kb",
        "position": {
          "x": 250.0,
          "y": 300.0
        },
        "type": "knowledge",
        "data": {
          "label": "Notes",
          "notes": "",
          "description": "Your notes and documents",
          "sources": [
            "pdf",
            "markdown",
            "text"
          ],
          "chunker": "recursive",
          "chunk_size": 800,
          "overlap": 100,
          "embedding": "local_bge_small",
          "vector_store": "chroma",
          "retrieval": "hybrid",
          "top_k": 6,
          "reranker": "cross_encoder"
        }
      }
    ],
    "edges": [
      {
        "id": "e-start-out-retrieve",
        "source": "start",
        "target": "retrieve",
        "sourceHandle": "out",
        "targetHandle": "in"
      },
      {
        "id": "e-retrieve-out-answer",
        "source": "retrieve",
        "target": "answer",
        "sourceHandle": "out",
        "targetHandle": "in"
      },
      {
        "id": "e-answer-out-reply",
        "source": "answer",
        "target": "reply",
        "sourceHandle": "out",
        "targetHandle": "in"
      },
      {
        "id": "a-kb-retrieve",
        "source": "kb",
        "target": "retrieve",
        "sourceHandle": "attach",
        "targetHandle": "knowledge"
      }
    ]
  },
  "ui": {
    "framework": "nextjs",
    "streaming": true,
    "feedback": true,
    "show_steps": true,
    "title": ""
  },
  "deploy": {
    "target": "docker_compose",
    "backend_port": 8000,
    "frontend_port": 3000
  },
  "observability": {
    "langsmith": false
  }
}
