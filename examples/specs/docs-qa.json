{
  "spec_version": "0.2",
  "project": {
    "name": "docs-qa",
    "description": "Answer questions over your company PDFs and Markdown, with sources."
  },
  "llm": {
    "provider": "anthropic",
    "model": "claude-opus-5-5",
    "temperature": 0.2,
    "effort": null,
    "max_tokens": 4096
  },
  "backend": {
    "language": "python"
  },
  "graph": {
    "nodes": [
      {
        "id": "start",
        "position": {
          "x": 0.0,
          "y": 0.0
        },
        "type": "input",
        "data": {
          "label": "Chat input",
          "notes": "",
          "greeting": "Ask me anything about the docs."
        }
      },
      {
        "id": "assistant",
        "position": {
          "x": 250.0,
          "y": 0.0
        },
        "type": "agent",
        "data": {
          "label": "Docs assistant",
          "notes": "",
          "role": "Answers questions using the company documents.",
          "system_prompt": "You answer questions about the company's documents.\nAlways search the knowledge base before answering. Quote the source file for every claim.\nIf the documents don't contain the answer, say so plainly instead of guessing.",
          "model": null,
          "temperature": null,
          "effort": null,
          "max_steps": 8
        }
      },
      {
        "id": "reply",
        "position": {
          "x": 500.0,
          "y": 0.0
        },
        "type": "output",
        "data": {
          "label": "Reply",
          "notes": ""
        }
      },
      {
        "id": "docs",
        "position": {
          "x": 250.0,
          "y": 300.0
        },
        "type": "knowledge",
        "data": {
          "label": "Company docs",
          "notes": "",
          "description": "Company policies, handbooks and product docs",
          "sources": [
            "pdf",
            "markdown"
          ],
          "chunker": "recursive",
          "chunk_size": 800,
          "overlap": 100,
          "embedding": "local_bge_small",
          "vector_store": "pgvector",
          "retrieval": "hybrid",
          "top_k": 6,
          "reranker": "none"
        }
      },
      {
        "id": "memory",
        "position": {
          "x": 440.0,
          "y": 300.0
        },
        "type": "memory",
        "data": {
          "label": "Memory",
          "notes": "",
          "short_term": "postgres",
          "long_term": false
        }
      }
    ],
    "edges": [
      {
        "id": "e-start-out-assistant",
        "source": "start",
        "target": "assistant",
        "sourceHandle": "out",
        "targetHandle": "in"
      },
      {
        "id": "e-assistant-out-reply",
        "source": "assistant",
        "target": "reply",
        "sourceHandle": "out",
        "targetHandle": "in"
      },
      {
        "id": "a-docs-assistant",
        "source": "docs",
        "target": "assistant",
        "sourceHandle": "attach",
        "targetHandle": "tools"
      },
      {
        "id": "a-memory-assistant",
        "source": "memory",
        "target": "assistant",
        "sourceHandle": "attach",
        "targetHandle": "tools"
      }
    ]
  },
  "ui": {
    "framework": "nextjs",
    "streaming": true,
    "feedback": true,
    "show_steps": true,
    "title": ""
  },
  "deploy": {
    "target": "docker_compose",
    "backend_port": 8000,
    "frontend_port": 3000
  },
  "observability": {
    "langsmith": false
  }
}
